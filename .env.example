# Server environment only. Set the real key in the process or Render, never here.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
AI_AUDIO_DAILY_LIMIT=50
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
PORT=3001
AI_DAILY_CALL_LIMIT=500
AI_SESSION_DAILY_LIMIT=80
AI_IP_DAILY_LIMIT=120
AI_MAX_CONCURRENT=3
AI_EVALUATION_MAX_TOKENS=1100
AI_CHAT_MAX_TOKENS=700
# Static build environment: only a public URL, no credentials.
PUBLIC_API_URL=https://cap70-pedagogie-api.onrender.com
